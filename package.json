{
  "name": "bidrush",
  "private": true,
  "description": "Real-time 1-minute auctions with an atomic bid engine and bot detection.",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bidrush/api --filter @bidrush/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts --noEmit",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @bidrush/api seed",
    "bots": "tsx scripts/bot-simulator.ts"
  },
  "devDependencies": {
    "@bidrush/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "ws": "^8.22.0"
  }
}
