# Copy to .env for `pnpm dev` (Docker Compose sets its own values).
# Every API variable is validated at startup by apps/api/src/config.ts and
# apps/api/src/antibot/config.ts; the API refuses to start in production
# with development defaults.

# --- API: runtime ------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Shown in logs and metrics; defaults to a random id.
# INSTANCE_ID=api-1
DATABASE_URL=postgres://bidrush:bidrush@localhost:5432/bidrush
REDIS_URL=redis://localhost:6379
# Apply migrations at startup (advisory-locked: safe with several instances).
RUN_MIGRATIONS=true
# Keep a rolling schedule of demo auctions so the site always has some live.
AUTOPILOT=true

# --- API: security -----------------------------------------------------
# At least 32 characters: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Origins allowed to call the API with cookies and open WebSockets (comma-separated).
CORS_ORIGINS=http://localhost:5173
# true behind HTTPS (required in production).
COOKIE_SECURE=false
# true when the web app is on another site (e.g. Vercel + Railway): SameSite=None.
COOKIE_CROSS_SITE=false
# Reverse proxies in front of the API (nginx = 1). 0 when exposed directly.
TRUST_PROXY_HOPS=1
SESSION_TTL_HOURS=168
SIGNUP_CREDITS=1000
AUTH_RATE_LIMIT_PER_MINUTE=10
# When set, GET /metrics requires "Authorization: Bearer <token>".
# METRICS_TOKEN=

# --- API: auctions (milliseconds) --------------------------------------
AUCTION_DURATION_MS=60000
SOFT_CLOSE_WINDOW_MS=5000
SOFT_CLOSE_EXTENSION_MS=5000
SOFT_CLOSE_MAX_EXTENSION_MS=30000

# --- API: anti-bot engine ----------------------------------------------
# enforce · monitor (log and store decisions, act on nothing) · off
ANTIBOT_MODE=enforce
ANTIBOT_THROTTLE_AT=0.35
ANTIBOT_CHALLENGE_AT=0.6
ANTIBOT_BLOCK_AT=0.85
# Leading zero hex digits of the proof-of-work: 4 ≈ 65k hashes ≈ 1 s in a browser.
ANTIBOT_POW_DIFFICULTY=4
# Bids per minute from one IP before it counts as a signal (NAT: keep it generous).
ANTIBOT_IP_PER_MINUTE=300

# --- Seed and scripts --------------------------------------------------
ADMIN_EMAIL=admin@bidrush.dev
ADMIN_PASSWORD=bidrush-admin-demo

# --- Web (build time) --------------------------------------------------
# Leave unset to use the same-origin /api and /ws (Vite proxy, nginx).
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
