# Copy to .env for `pnpm dev` (Docker Compose sets its own values).
# Every variable is validated at startup by apps/api/src/config.ts.

# --- API -------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://bidrush:bidrush@localhost:5432/bidrush
REDIS_URL=redis://localhost:6379
# At least 32 characters. Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:5173
# true behind HTTPS (required in production).
COOKIE_SECURE=false
# true when the web app is served from another site (e.g. Vercel + Railway).
COOKIE_CROSS_SITE=false

# Auction timing (milliseconds).
AUCTION_DURATION_MS=60000
SOFT_CLOSE_WINDOW_MS=5000
SOFT_CLOSE_EXTENSION_MS=5000
SOFT_CLOSE_MAX_EXTENSION_MS=30000

# --- Web (build time) --------------------------------------------------
# Leave unset to use the same-origin /api proxy (Vite dev server, nginx).
# VITE_API_URL=https://api.example.com
