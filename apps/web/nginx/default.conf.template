# Serves the SPA and reverse-proxies the API on the same origin, so the
# session cookie is first-party and WebSockets carry it. Requests are spread
# over every API instance (upstream "api", generated at startup from
# API_UPSTREAMS by 25-bidrush-upstream.sh); no sticky sessions are needed.
#
# ${VARS} are filled in by the nginx image at startup (envsubst); nginx's own
# $variables are left alone.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        proxy_pass http://api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    location /ws {
        proxy_pass http://api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    # Hashed assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-side routes.
    location / {
        try_files $uri /index.html;
    }
}
